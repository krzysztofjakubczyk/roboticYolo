<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/item_country_letter_tv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/y_120"
        android:background="@color/colorGray"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/x_48"
        android:paddingRight="@dimen/x_48"
        android:singleLine="true"
        android:text="A"
        android:textColor="@color/colorTextBlack"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/item_country_name_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/y_120"
        android:layout_below="@id/item_country_letter_tv"
        android:background="@drawable/bg_btn_white"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/x_48"
        android:paddingRight="@dimen/x_48">

        <TextView
            android:id="@+id/item_country_name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="中国"
            android:textColor="@color/colorText"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/item_country_code_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/x_48"
            android:singleLine="true"
            android:text="+86"
            android:textColor="@color/colorText"
            android:textSize="15sp" />

    </LinearLayout>


    <include
        layout="@layout/divider_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
